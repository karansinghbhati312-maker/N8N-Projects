    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"orders\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"email_id\": {\n            \"type\": \"string\"\n          },\n          \"store\": {\n            \"type\": \"string\"\n          },\n          \"order_id\": {\n            \"type\": \"string\"\n          },\n          \"items\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"amount\": {\n            \"type\": \"number\"\n          },\n          \"currency\": {\n            \"type\": \"string\"\n          },\n          \"order_date\": {\n            \"type\": \"string\"\n          },\n          \"delivery_date\": {\n            \"type\": \"string\"\n          },\n          \"category\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Electronics\",\n              \"Clothing\",\n              \"Groceries\",\n              \"Beauty\",\n              \"Books\",\n              \"Home\",\n              \"Food\",\n              \"Other\"\n            ]\n          },\n          \"ai_reasoning\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"email_id\",\n          \"store\",\n          \"order_id\",\n          \"items\",\n          \"amount\",\n          \"currency\",\n          \"order_date\",\n          \"delivery_date\",\n          \"category\",\n          \"ai_reasoning\"\n        ]\n      }\n    }\n  },\n  \"required\": [\"orders\"]\n}"
